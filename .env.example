# Copy values into your service environment; CLI does not automatically read .env.
SORTER_MODEL=artifacts/real-model
SORTER_SEGMENTER=artifacts/segmentation-model
SORTER_THRESHOLD=0.85
SORTER_HOST=127.0.0.1
SORTER_PORT=8000
SORTER_RATE_LIMIT=60
SORTER_REQUEST_TIMEOUT=15
# For non-loopback deployment, use a mounted key file (minimum 16 characters).
# SORTER_API_KEY_FILE=/run/secrets/sorter_api_key
